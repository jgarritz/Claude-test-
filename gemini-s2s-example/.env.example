# Google Gemini API Key (obtenla en https://aistudio.google.com/apikey)
GOOGLE_API_KEY=tu-api-key-aqui

# Puerto del servidor WebSocket (default: 3000)
WS_PORT=3000

# Nivel de log: info, debug, warn, error
LOGLEVEL=info

# (Opcional) MCP Server para tools adicionales
# MCP_SERVER_PORT=3001
# MCP_SERVER_URL=http://localhost:3001/sse
